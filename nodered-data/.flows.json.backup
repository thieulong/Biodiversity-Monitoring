        "name": "Insert detection row",
        "query": "INSERT INTO sensor_data(time,sensor_id,start_seconds,end_seconds,scientific_name,common_name,confidence)\nVALUES($1,$2,$3,$4,$5,$6,$7);\n",
        "postgreSQLConfig": "fbd14997310e037a",
        "split": false,
        "rowsPerMsg": "",
        "outputs": 1,
        "x": 670,
        "y": 240,
        "wires": [
