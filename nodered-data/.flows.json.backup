    {
        "id": "891fbba0ee1f929d",
        "type": "function",
        "z": "csv-upload",
        "name": "Handle multi-file upload",
        "func": "let files = msg.req.files || [];\n\nfor (let i = 0; i < files.length; i++) {\n  const f = files[i];\n\n  node.send([{\n    payload: f.buffer,\n    filename: f.originalname,\n    mimetype: f.mimetype,\n    size: f.size,\n    fieldname: f.fieldname,\n    id: msg.req.body?.[`id${i}`]\n  }, null]);\n}\n\nnode.send([null, { payload: { success: true, count: files.length } }]);\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 420,
