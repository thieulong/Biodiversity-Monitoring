        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://localhost:1880/detections?start={{payload.start}}&end={{payload.end}}&species={{payload.species}}&exclude={{payload.exclude}}&confidence_min={{payload.confidence_min}}",
        "tls": "",
