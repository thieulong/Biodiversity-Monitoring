        "func": "const p = msg.req.body;\nif (!p.sensor_id || typeof p.settings !== 'object') {\n    msg.res = { statusCode: 400, payload: { error: 'sensor_id and settings required' }};\n    return [ null, msg ];\n}\nmsg.payload = p;\nreturn [ msg, null ];",
