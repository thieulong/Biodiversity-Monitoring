    {
        "id": "cc6e3a43dca1be1d",
        "type": "function",
        "z": "csv-upload",
        "d": true,
        "name": "DB flush timer",
        "func": "let duration = 600; \nif (msg.duration) duration = msg.duration;\n\nlet timer = context.get('timer');\n\n// If CSV is uploaded: reset and start countdown\nif (msg.payload === \"Data uploaded successfully!\") {\n    if (timer) clearTimeout(timer);\n    msg.payload = formatTime(duration);\n    node.send(msg);\n    tick(duration - 1);\n    return null;\n}\n\n// If Flush button clicked: clear timer and set display to 00:00:00 (don't restart timer)\nif (msg.payload === \"Flush button clicked\") {\n    if (timer) clearTimeout(timer);\n    context.set('timer', null);\n    msg.payload = \"00:00:00\";\n    node.send(msg);\n    return null;\n}\n\n// In all other cases, clear timer and start countdown\nif (timer) clearTimeout(timer);\n\nfunction formatTime(seconds) {\n    let hrs = Math.floor(seconds / 3600);\n    let mins = Math.floor((seconds % 3600) / 60);\n    let secs = seconds % 60;\n    return (\n        String(hrs).padStart(2, '0') + ':' +\n        String(mins).padStart(2, '0') + ':' +\n        String(secs).padStart(2, '0')\n    );\n}\n\nfunction tick(remaining) {\n    if (remaining > 0) {\n        let m = { ...msg }; \n        m.payload = formatTime(remaining);\n        node.send(m);\n        context.set('timer', setTimeout(() => tick(remaining - 1), 1000));\n    } else {\n        let m = { ...msg };\n        m.payload = \"00:00:00\";\n        node.send(m);\n        context.set('timer', null);\n    }\n}\n\n// For any other trigger, start timer as before\ntick(duration);\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 460,
        "wires": [
            [
                "1e46096e51f331d7"
            ]
        ]
    },
    {
        "id": "b4aee4421d7109e7",
        "type": "function",
